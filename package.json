{
  "name": "ayvu-brain",
  "version": "0.2.0",
  "description": "AYVU Brain - Local-first Windows desktop workspace for Second Brain notes, threads, bot-free meetings, parallel Git worktree agents and multi-AI (Claude, Codex/OpenAI, Gemini, Grok).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node src/server.mjs",
    "install:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows.ps1",
    "uninstall:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-windows.ps1",
    "test": "node --test",
    "check": "node --check src/server.mjs"
  },
  "license": "MIT"
}
